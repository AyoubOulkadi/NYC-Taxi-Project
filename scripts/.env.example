# Azure Storage (valeurs issues de `terraform output` — étape 1)
AZURE_STORAGE_ACCOUNT_NAME=nycmobilitydevsa
AZURE_STORAGE_ACCOUNT_KEY=<terraform output storage_account_primary_key>

# Event Hubs (pour le simulateur de replay et le weather poller)
EVENTHUB_PRODUCER_CONN_STR=<terraform output eventhub_producer_connection_string>
EVENTHUB_NAME=nyc-events

# Source des données brutes (TLC / Citi Bike publient en open data — URLs publiques)
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
CITIBIKE_BASE_URL=https://s3.amazonaws.com/tripdata

# Weather API (exemple avec Open-Meteo, pas de clé requise)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# Simulateur de replay
REPLAY_SPEED_FACTOR=720   # 1 mois d'historique rejoué en ~1h
